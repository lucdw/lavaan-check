+ Hopeless~Hopelesslag
+ TB~TBlag
+ PB~PBlag
+ SI~SIlag
+ TB~PB
+ PB~Hopeless
+ SI~PB
+ '
+ )
> object <- try(lavParseModelString(
+ as.data.frame. = TRUE, model.syntax = Model, parser = 'new'
+ ), outFile = stdout())
