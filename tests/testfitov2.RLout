> options(warn = 1L)
> 
> # 2-variable model: simple regression
> # set.seed(1234)
> # x1 = rnorm(100)
> # y1 = 0.5 + 2*x1 + rnorm(100)
> # Data <- data.frame(y1 = y1, x1 = x1)
> Data <- read.csv("testfitov2_dat01.csv")
> 
> model <- ' y1 ~ x1 '
> fit <- sem(model, data=Data, fixed.x=TRUE)
> 
