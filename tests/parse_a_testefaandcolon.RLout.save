> library(lavaan)
This is lavaan 0.6-22.2670
lavaan is FREE software! Please report any bugs.
> 
> set.seed(1234)
> 
> Model <- c(
+ '
+     F1 =~ "a b"*X1
+     F2 =~ a * X1 + 3*X2 # dat is hier een beetje commentaar
+     # efa block 2
+     efa("efa2")*f3 + 
+     efa("efa2")*f4 =~ y1 + y2 + y3 + y1:y3
+     f4 := 3.14159 * F2
+     F1 ~ start(0.76)*F2 + a*F2
+     a == (b + f3)^2
+     b1 > exp(b2 + b3) 
+ '
+ )
> object <- try(lavParseModelString(
+ as.data.frame. = TRUE, model.syntax = Model, parser = 'new'
+ ), outFile = stdout())
> if (!inherits(object, 'try-error')) {withAutoprint({
+ print(as.data.frame(object))
+ })}
> print(as.data.frame(object))
   lhs op   rhs mod.idx block fixed start lower upper label prior  efa rv
1   F1 =~    X1       1     1                           a b              
2   F2 =~    X1       2     1                             a              
3   F2 =~    X2       3     1     3                                      
