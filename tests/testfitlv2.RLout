> options(warn = 1L)
> 
> # two-factor (no eXo)
> # set.seed(123)
> # pop.model <- ' f1 =~ 0.7*y1 + 0.7*y2 + 0.5*y3
> #                f2 =~ 0.6*y4 + 0.6*y5 + 0.5*y6 '
> # Data <- simulateData(pop.model, sample.nobs=200)
> Data <- read.csv("testfitlv2_dat01.csv")
> 
> model <- ' f1 =~ y1 + y2 + y3
+            f2 =~ y4 + y5 + y6 '
> fit <- sem(model, data=Data, fixed.x=TRUE)
> 
> # default extract functions
> source("common.srcR", echo = TRUE)

