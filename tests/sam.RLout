> # GROWTH
> model.syntax <- '
+ # intercept and slope with fixed coefficients
+   i =~ 1*t1 + 1*t2 + 1*t3 + 1*t4
+   s =~ 0*t1 + 1*t2 + 2*t3 + 3*t4
+ 
+ # random effects
+   t1 + t2 + t3 + t4 ~ 0*1
+   i + s ~ 1
+   i ~~ s
+ 
+ # regressions
+ #  i ~ x1 + x2
+ #  s ~ x1 + x2
+ 
+ # time-varying covariates
+ #  t1 ~ c1
+ #  t2 ~ c2
+ #  t3 ~ c3
+ #  t4 ~ c4
+ '
> fit.sam <- sam(model.syntax, data = Demo.growth,
+                         mm.list = list(is = c("i", "s")))
> summary(fit.sam)
