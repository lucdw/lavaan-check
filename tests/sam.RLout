> ## The industrialization and Political Democracy Example
> ## Bollen (1989), page 332
> model <- '
+   # latent variable definitions
+      ind60 =~ x1 + x2 + x3
+      dem60 =~ y1 + d2*y2 + d3*y3 + d4*y4
+      dem65 =~ y5 + d2*y6 + d3*y7 + d4*y8
+ 
+   # regressions
+     dem60 ~ a*ind60
+     dem65 ~ c*ind60 + b*dem60
+ 
+   # residual correlations
+     y1 ~~ y5
+     y2 ~~ y4 + y6
+     y3 ~~ y7
+     y4 ~~ y8
+     y6 ~~ y8
+ 
+     indirect := a*b
+ '
