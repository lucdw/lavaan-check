> 
> # block 2: fitting traditional SEM
> model <- '
+     # measurement part
+     Y  =~ y1 + y2  + y3  + y4
+     M  =~ m1 + m2  + m3  + m4
+     X1 =~ x1 + x2  + x3  + x4
+     X2 =~ x5 + x6  + x7  + x8
+     X3 =~ x9 + x10 + x11 + x12
+ 
+     # structural part
+     Y ~ X3 + M + Age
+     M ~ X1 + X2
+ '
