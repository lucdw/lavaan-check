> ## The famous Holzinger and Swineford (1939) example
> HS.model <- ' visual  =~ x1 + x2 + x3
+               textual =~ x4 + x5 + x6
+               speed   =~ x7 + x8 + x9 '
> 
> TR <- function(x) { sum(diag(x)) }
> 
> 
> # default if when estimator = "MLR" is test = "yuan.bentler.mplus"
> # 9 May 2020 - dev 0.6-6
> fit <- cfa(HS.model, data = HolzingerSwineford1939, estimator = "MLR")
> # unlist(fit@test[[2]][c("stat", "df", "scaling.factor", "scaling.factor.h1", "scaling.factor.h0", "trace.UGamma")])
> #              stat                df    scaling.factor scaling.factor.h1
> #        87.1316034        24.0000000         0.9790423         1.0510101
> # scaling.factor.h0      trace.UGamma
> #         1.1332591        23.4970142
> 
> # fit@Options$test
> # [1] "yuan.bentler.mplus"
> 
> # fit@Options$information
> # [1] "observed" "observed"
> 
> # fit@Options$h1.information
> # [1] "structured" "structured"
> 
> # fit@Options$observed.information
> # "hessian" "hessian"
> 
> # 1. test = "yuan.bentler.mplus"
> fit <- cfa(HS.model, data = HolzingerSwineford1939,
+            test = "yuan.bentler.mplus",
+            information = c("observed", "observed"),
+            h1.information = c("structured", "structured"),
+            observed.information = c("hessian", "hessian"))
> unlist(fit@test[[2]][c("stat", "df", "scaling.factor", "scaling.factor.h1",
+                        "scaling.factor.h0", "trace.UGamma")])
             stat                df    scaling.factor scaling.factor.h1 
       87.1316034        24.0000000         0.9790423         1.0510101 
scaling.factor.h0      trace.UGamma 
        1.1332591        23.4970142 
> #              stat                df    scaling.factor scaling.factor.h1
> #        87.1316034        24.0000000         0.9790423         1.0510101
> # scaling.factor.h0      trace.UGamma
> #         1.1332591        23.4970142
> 
> 
> # manual
> h1.options <- h0.options <- fit@Options
> h1.options$information    <- "observed"
> h1.options$h1.information <- "unstructured" # typical for yuan.bentler.mplus
> h0.options$information          <- "observed"
> h0.options$observed.information <- "hessian"
> h0.options$h1.information       <- "structured" # not used
> 
> A1 <- lavaan:::lav_model_h1_info_observed(lavmodel = fit@Model,
+           lavoptions = h1.options, lavdata = fit@Data,
+           lavsamplestats = fit@SampleStats)[[1]]
> B1 <- lavaan:::lav_model_h1_info_firstorder(lavmodel = fit@Model,
+           lavoptions = h1.options, lavdata = fit@Data,
+           lavsamplestats = fit@SampleStats)[[1]]
> A0 <- lavaan:::lav_model_info_observed(lavmodel = fit@Model,
+           lavoptions = h0.options, lavdata = fit@Data,
+           lavsamplestats = fit@SampleStats)
> B0 <- lavaan:::lav_model_info_firstorder(lavmodel = fit@Model,
+           lavoptions = h0.options, lavdata = fit@Data,
+           lavsamplestats = fit@SampleStats)
> TR(B1 %*% solve(A1)) - TR(B0 %*% solve(A0))
[1] 23.49701
> # 23.49701
> 
> 
